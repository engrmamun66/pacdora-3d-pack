// Database schema. Connection URL lives in prisma.config.ts (Prisma 7).
// Auth models follow Better Auth 1.7 core tables (user, session, account,
// verification, rateLimit); field names must match what Better Auth expects.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (Better Auth) ----

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  /// "user" or "superadmin". Set only by the server-side CLI (npm run admin:create), never from the web.
  role             String            @default("user")
  /// Suspended accounts cannot sign in and lose their sessions.
  banned           Boolean           @default(false)
  bannedAt         DateTime?
  banReason        String?
  /// Contact details the customer adds on the profile settings tab (all optional).
  phone            String?
  altPhone         String?
  businessName     String?
  businessAddress  String?
  /// The Client's logo (PNG or JPEG) shown on their shared pages: a storage key, and its MIME type. Both null = no logo.
  businessLogoKey  String?
  businessLogoMime String?
  /// How the Client's shared pages show their templates: cards per row (2 to 6) and which picture is on a card ("dieline" or "3d").
  cardColumns      Int               @default(4)
  cardImage        String            @default("dieline")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  projects         Project[]
  assets           Asset[]
  aiRequests       AiRequest[]
  rateEvents       RateEvent[]
  categories       UserCategory[]
  tags             UserTag[]
  favoriteArtworks ArtworkFavorite[]
  shareLinks       ShareLink[]
  clientOrders     Order[]
  captures         ProjectCapture[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// One row per login method: "credential" (email/password, holds the hash) or an OAuth provider.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Rate-limit counters (database storage survives restarts and multiple instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---- Domain models (merged into schema.prisma) ----

/// A packaging template: one parametric generator + a named preset.
/// Geometry rules live in code (packages/dieline-engine); the DB stores the
/// catalogue entry and its default parameters.
model Template {
  id                String             @id // stable slug, e.g. "tuck-end-carton-straight"
  generatorId       String // engine template id, e.g. "tuck-end-carton"
  name              String
  category          String // e.g. "folding-carton", "mailer", "shipping"
  description       String
  schemaVersion     Int
  defaultParameters Json               @db.JsonB
  previewUrl        String?
  /// Where the template is in the admin's workflow: draft, step-1, step-2, hide, published, sealed (see lib/template-status.ts).
  status            String             @default("published")
  /// Public on the site. Always equals (status == "published"); kept as its own column so public queries stay simple and indexed.
  published         Boolean            @default(true)
  /// "builtin" = parametric generator in code (seeded); "svg" = imported from an SVG by an admin.
  source            String             @default("builtin")
  /// For source "svg": the parsed dieline (millimetres) and the role chosen for each line style.
  geometry          Json?              @db.JsonB
  widthMm           Float?
  heightMm          Float?
  /// Small SVG (as text) for lists; built when the template is saved. Keeps list pages light.
  thumbnail         String?
  /// Optional box background picture set by an admin (file in storage). Default for new projects; fills the dieline on SVG template pages.
  backgroundKey     String?
  backgroundMime    String?
  /// PNG of the 3D box that the template list shows (saved by an admin from the 3D view editor; file in storage).
  productImageKey   String?
  /// Built-in templates: board thickness (mm) new projects start with, set by an admin (see docs/thickness.md). Null = the template's own default.
  defaultThickness  Float?
  /// Camera and fold amount the 3D preview starts with (set by an admin). Null = standard view.
  viewSettings      Json?              @db.JsonB
  /// Window holes new projects start with (array of WindowDoc, sheet frame in mm at the template's default size). Null = none. Set by an admin.
  windows           Json?              @db.JsonB
  /// Imported templates only: true when an admin has set up the 3D fold (stored in geometry.fold).
  hasFold           Boolean            @default(false)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projects          Project[]
  categories        TemplateCategory[]

  @@index([category])
  @@index([generatorId])
  @@index([source, published])
  @@map("template")
}

/// A user's packaging project. `projectData` holds the full versioned
/// ProjectDoc JSON (parameters, artwork, 3D and export settings).
model Project {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Short address-friendly name, unique among the Client's own projects (see lib/slug.ts).
  slug         String
  templateId   String
  template     Template      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  projectData  Json          @db.JsonB
  /// The customer's own category for this project (one at most), see UserCategory.
  categoryId   String?
  category     UserCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         ProjectTag[]
  shareLinks   ShareLink[]
  captures     ProjectCapture[]
  orderItems   OrderItem[]
  thumbnailUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assets       Asset[]

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([categoryId])
  @@index([userId, templateId])
  @@map("project")
}

/// A category a customer made for sorting their own projects (like a folder). Private to the customer.
model UserCategory {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]

  @@unique([userId, name])
  @@map("user_category")
}

/// A tag a customer made; a project can carry several. Private to the customer.
model UserTag {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  projects  ProjectTag[]

  @@unique([userId, name])
  @@map("user_tag")
}

model ProjectTag {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagId     String
  tag       UserTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tag")
}

/// A 3D picture of a project taken in the online design page (a layout and a fold amount of the Client's choice). The cover one is shown on the cards of the shared pages.
model ProjectCapture {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Where the PNG is kept (see the storage provider).
  storageKey String   @unique
  sizeBytes  Int
  /// Name of the layout it was taken with ("Sample 2"), if any, and how far folded (0 flat to 1 closed).
  layoutName String?
  progress   Float    @default(1)
  /// The camera when it was taken (turn, tilt, zoom, pan: a ViewSettings), so the same view can be put back.
  view       Json?    @db.JsonB
  /// The design as it was when taken (box parameters, windows, artwork, 3D colours), so a shared page can show this sample as designed. Null for pictures taken before this existed.
  design     Json?    @db.JsonB
  cover      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@map("project_capture")
}

/// Uploaded or generated file. Bytes live in object storage; only the key/URL here.
model Asset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileName   String
  fileType   String // MIME type
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("asset")
}

/// One AI parameter-extraction request (for the per-user daily quota and auditing).
model AiRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ok | needs_info | unsupported | invalid | error
  outcome    String
  inputChars Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_request")
}

/// One counted action for per-user rate limits (export, upload, save, AI). Old rows are pruned on use.
model RateEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("rate_event")
}

/// Site-wide settings edited by super admins (e.g. key "hero" = home page hero options).
model SiteSetting {
  key         String   @id
  value       Json     @db.JsonB
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("site_setting")
}

/// Browse groups for templates. kind "use" = By Uses (Gift Boxes, Food ...), "model" = By Models (FEFCO, Tuck End ...).
/// "All" is not a row: it means no filter. A template may belong to several categories.
model TemplateCategory {
  id        String     @id @default(cuid())
  kind      String
  slug      String
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  templates Template[]

  @@unique([kind, slug])
  @@index([kind, sortOrder])
  @@map("template_category")
}

/// A picture an admin added to the artwork library (shown in the customer artwork menu). The file is in storage (PNG or JPEG).
model ArtworkItem {
  id          String   @id @default(cuid())
  name        String
  /// Search words, lower case, at most 12 (see lib/artwork-meta.ts).
  tags        String[]
  /// Free text group, "" = none. The admin picks an existing one or types a new one.
  category    String   @default("")
  storageKey  String   @unique
  mime        String
  widthPx     Int
  heightPx    Int
  sizeBytes   Int
  createdById String?
  /// Background pictures only: shown under the 3D view on the shared (portal) template pages, for a customer to try behind the box.
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites ArtworkFavorite[]

  @@index([featured])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("artwork_item")
}

/// A library picture a customer starred (the editor's "Favorites" tab). Private to the customer.
/// How the box is shown on the shared template pages ("Sample 1", "Sample 2" ...): an arrangement of copies of the box and a camera.
/// The same list for every template. `spec` is a LayoutSpec (lib/scene-layout.ts).
model TemplateLayout {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  spec      Json     @db.JsonB
  /// A small picture of the layout (a PNG in storage, "layouts/<id>.png"), shown where the layout is listed. Null = none.
  iconKey   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("template_layout")
}

model ArtworkFavorite {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   ArtworkItem @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([userId, artworkId])
  @@index([artworkId])
  @@map("artwork_favorite")
}

// ---- Client portal: shared template pages, customers (phone + OTP) and their orders ----

/// A permanent, hashed public link of a Client (a signed-in user): all templates, one category, one tag, or one template.
/// The "all" link's hash is the Client's user hash (the first part of every portal address). Turning a link off keeps its address.
model ShareLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "all" | "category" | "tag" | "template"
  scope     String
  /// UserCategory id, UserTag id or Project id (null for "all").
  targetId  String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hash      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, scope, targetId])
  @@index([userId])
  @@map("share_link")
}

/// A buyer on a Client's portal. The phone number is the identity (checked with a one-time code); not a Client account.
model Customer {
  id        String            @id @default(cuid())
  /// Digits with country code, e.g. 8801712345678.
  phone     String            @unique
  fullName  String            @default("")
  country   String            @default("Bangladesh")
  district  String            @default("")
  address   String            @default("")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sessions  CustomerSession[]
  orders    Order[]

  @@map("customer")
}

/// A one-time sign-in code sent to a phone. Only a hash of the code is kept.
model CustomerOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt(sort: Desc)])
  @@map("customer_otp")
}

model CustomerSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_session")
}

/// An order a customer placed on a Client's portal. The contact details are copied at order time.
model Order {
  id           String      @id @default(cuid())
  /// A short number the Client and the customer both see (ORD-1001 ...).
  number       Int         @default(autoincrement())
  clientId     String
  client       User        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// new | confirmed | in_progress | done | cancelled
  status       String      @default("new")
  customerName String
  phone        String
  country      String
  district     String
  address      String
  notes        String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("order")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// The template's name when ordered (the Client may rename or delete it later).
  name      String
  quantity  Int
  details   String   @default("")

  @@index([orderId])
  @@map("order_item")
}
