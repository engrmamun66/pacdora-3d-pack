// Database schema. Connection URL lives in prisma.config.ts (Prisma 7).
// Auth models follow Better Auth 1.7 core tables (user, session, account,
// verification, rateLimit); field names must match what Better Auth expects.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (Better Auth) ----

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// "user" or "superadmin". Set only by the server-side CLI (npm run admin:create), never from the web.
  role          String    @default("user")
  /// Suspended accounts cannot sign in and lose their sessions.
  banned        Boolean   @default(false)
  bannedAt      DateTime?
  banReason     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  assets        Asset[]
  aiRequests    AiRequest[]
  rateEvents    RateEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// One row per login method: "credential" (email/password, holds the hash) or an OAuth provider.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Email verification and password reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Rate-limit counters (database storage survives restarts and multiple instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---- Domain models (merged into schema.prisma) ----

/// A packaging template: one parametric generator + a named preset.
/// Geometry rules live in code (packages/dieline-engine); the DB stores the
/// catalogue entry and its default parameters.
model Template {
  id                String    @id // stable slug, e.g. "tuck-end-carton-straight"
  generatorId       String    // engine template id, e.g. "tuck-end-carton"
  name              String
  category          String    // e.g. "folding-carton", "mailer", "shipping"
  description       String
  schemaVersion     Int
  defaultParameters Json      @db.JsonB
  previewUrl        String?
  published         Boolean   @default(true)
  /// "builtin" = parametric generator in code (seeded); "svg" = imported from an SVG by an admin.
  source            String    @default("builtin")
  /// For source "svg": the parsed dieline (millimetres) and the role chosen for each line style.
  geometry          Json?     @db.JsonB
  widthMm           Float?
  heightMm          Float?
  /// Small SVG (as text) for lists; built when the template is saved. Keeps list pages light.
  thumbnail         String?
  /// Optional box background picture set by an admin (file in storage). Default for new projects; fills the dieline on SVG template pages.
  backgroundKey     String?
  backgroundMime    String?
  /// PNG of the 3D box that the template list shows (saved by an admin from the 3D view editor; file in storage).
  productImageKey   String?
  /// Camera and fold amount the 3D preview starts with (set by an admin). Null = standard view.
  viewSettings      Json?     @db.JsonB
  /// Imported templates only: true when an admin has set up the 3D fold (stored in geometry.fold).
  hasFold           Boolean   @default(false)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  projects          Project[]
  categories        TemplateCategory[]

  @@index([category])
  @@index([generatorId])
  @@index([source, published])
  @@map("template")
}

/// A user's packaging project. `projectData` holds the full versioned
/// ProjectDoc JSON (parameters, artwork, 3D and export settings).
model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  templateId   String
  template     Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  projectData  Json     @db.JsonB
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets       Asset[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("project")
}

/// Uploaded or generated file. Bytes live in object storage; only the key/URL here.
model Asset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileName   String
  fileType   String   // MIME type
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("asset")
}

/// One AI parameter-extraction request (for the per-user daily quota and auditing).
model AiRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ok | needs_info | unsupported | invalid | error
  outcome   String
  inputChars Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_request")
}

/// One counted action for per-user rate limits (export, upload, save, AI). Old rows are pruned on use.
model RateEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt(sort: Desc)])
  @@map("rate_event")
}

/// Site-wide settings edited by super admins (e.g. key "hero" = home page hero options).
model SiteSetting {
  key         String   @id
  value       Json     @db.JsonB
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("site_setting")
}

/// Browse groups for templates. kind "use" = By Uses (Gift Boxes, Food ...), "model" = By Models (FEFCO, Tuck End ...).
/// "All" is not a row: it means no filter. A template may belong to several categories.
model TemplateCategory {
  id        String     @id @default(cuid())
  kind      String
  slug      String
  name      String
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  templates Template[]

  @@unique([kind, slug])
  @@index([kind, sortOrder])
  @@map("template_category")
}
