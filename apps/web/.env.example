# Copy to .env.local and adjust. Never commit real secrets.

# Postgres from infra/docker-compose.yml (port 5433 on localhost)
DATABASE_URL="postgresql://packaging:packaging_dev_only@127.0.0.1:5433/packaging"

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3100"

# Email. Local dev uses Mailpit (web UI: http://127.0.0.1:8025)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Dieline Studio <no-reply@localhost>"

# Cloudflare Turnstile. These are Cloudflare's official TEST keys (always pass).
# Replace with real keys for staging/production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Google sign-in (optional). Create at Google Cloud Console > Credentials > OAuth client (Web).
# Authorized redirect URI: http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
