# Copy to infra/.env.prod and fill in. Never commit the real file.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=https://your.domain
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Dieline Studio <no-reply@your.domain>"
# Real Cloudflare Turnstile keys for your domain (not the test keys).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=20
CLIENT_IP_HEADER=x-forwarded-for   # or cf-connecting-ip behind Cloudflare; the proxy must overwrite it
